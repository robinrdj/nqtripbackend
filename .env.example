# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. The database name goes in the path segment.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/qtrip?retryWrites=true&w=majority&appName=Cluster0

# --- Server ---------------------------------------------------------------
PORT=8082
NODE_ENV=development

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# --- Optional features ------------------------------------------------------
# Everything below may be left out. Each one switches its feature off, or to a
# local stand-in, rather than stopping the server from booting.

# The web client's address. Email links and ticket QR codes point here.
PUBLIC_APP_URL=http://localhost:8081

# Outgoing mail. When unset, emails are written to .mail-outbox/ as .eml files
# that open in any mail client. Any SMTP provider works (a Gmail app password,
# Brevo, Resend, Mailtrap...).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=QTrip <no-reply@qtrip.dev>

# Google sign-in. Create an OAuth "Web application" client in the Google Cloud
# console and add the frontend origin under Authorised JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Signs ticket QR codes. Defaults to a key derived from JWT_ACCESS_SECRET.
# TICKET_SECRET=
