{
  "name": "@qtrip/backend",
  "version": "3.0.0",
  "private": true,
  "description": "QTrip REST API (Express + TypeScript + MongoDB)",
  "license": "ISC",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/seed.ts",
    "seed:fresh": "tsx src/seed/seed.ts --fresh",
    "dev:memory": "tsx watch src/dev-server.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lowdb": "^1.0.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.11.0",
    "nanoid": "^3.3.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
